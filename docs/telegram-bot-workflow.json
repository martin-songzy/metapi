      "id": "get-targets",
      "name": "获取站点列表",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "MetAPI Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst chatId = $('提取命令').first().json.chatId;\n\nif (!data.sites || data.sites.length === 0) {\n  return { chatId, message: '⚠️ 没有可用的站点' };\n}\n\nlet message = `📋 可探测站点列表\\n\\n`;\nmessage += `总计：${data.summary.totalSites} 个站点，${data.summary.totalModels} 个模型\\n\\n`;\n\ndata.sites.forEach((site, index) => {\n  message += `${index + 1}. ${site.siteName} (ID: ${site.siteId})\\n`;\n  message += `   平台：${site.platform} | 状态：${site.status}\\n`;\n  message += `   模型数：${site.modelCount}\\n`;\n  \n  if (site.models && site.models.length > 0) {\n    const preview = site.models.slice(0, 3).join(', ');\n    message += `   示例：${preview}`;\n    if (site.models.length > 3) {\n      message += ` 等${site.models.length}个`;\n    }\n    message += `\\n`;\n  }\n  message += `\\n`;\n});\n\nmessage += `\\n💡 使用示例：\\n`;\nmessage += `/probe all - 探测全部站点\\n`;\nmessage += `/probe 1,2,3 - 探测指定站点`;\n\nreturn { chatId, message };"
      },
      "id": "format-targets",
      "name": "格式化站点列表",
