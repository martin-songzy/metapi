    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst chatId = $('提取命令').first().json.chatId;\n\nif (data.status === 'running') {\n  const progress = data.progress || {};\n  return { \n    chatId, \n    message: `🔄 任务执行中\\n\\n进度：${progress.current || 0}/${progress.total || '?'}`\n  };\n  \n} else if (data.status === 'completed') {\n  const summary = data.summary;\n  const available = data.available || [];\n  \n  let message = `✅ 任务已完成\\n\\n`;\n  message += `📊 统计：\\n`;\n  message += `- 总计：${summary.totalProbed} 个\\n`;\n  message += `- 可用：${summary.supported} 个\\n`;\n  message += `- 不可用：${summary.unsupported} 个\\n`;\n  message += `- 不确定：${summary.inconclusive} 个\\n\\n`;\n  \n  if (available.length > 0) {\n    message += `🟢 可用模型（前5个）：\\n`;\n    available.slice(0, 5).forEach(item => {\n      message += `• ${item.siteName} - ${item.modelName}\\n`;\n    });\n    if (available.length > 5) {\n      message += `\\n还有 ${available.length - 5} 个可用模型\\n`;\n    }\n  }\n  \n  return { chatId, message };\n  \n} else {\n  return { \n    chatId, \n    message: `❌ 任务失败或不存在`\n  };\n}"
      },
