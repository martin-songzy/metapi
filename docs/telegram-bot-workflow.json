      "parameters": {
        "jsCode": "const args = $('提取命令').first().json.args;\nconst chatId = $('提取命令').first().json.chatId;\n\nif (!args || args.trim() === '') {\n  return { chatId, message: '❌ 请提供任务ID\\n\\n用法：/status <taskId>' };\n}\n\nreturn { chatId, taskId: args.trim() };"
      },
