    {
      "parameters": {
        "url": "https://metapi-krj9.onrender.com/api/remote-probe/run",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "siteIds",
              "value": "={{ $json.args || 'all' }}"
            },
            {
              "name": "waitForCompletion",
              "value": true
            },
            {
              "name": "timeout",
              "value": 300000
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "probe-run",
      "name": "调用探测API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1340,
        80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "MetAPI Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst chatId = $('提取命令').first().json.chatId;\n\nif (data.status === 'completed') {\n  const summary = data.summary;\n  const available = data.available || [];\n  \n  let message = `✅ 探测完成\\n\\n`;\n  message += `📊 统计：\\n`;\n  message += `- 总计：${summary.totalProbed} 个\\n`;\n  message += `- 可用：${summary.supported} 个\\n`;\n  message += `- 不可用：${summary.unsupported} 个\\n`;\n  message += `- 不确定：${summary.inconclusive} 个\\n`;\n  message += `- 耗时：${(summary.durationMs / 1000).toFixed(1)}秒\\n\\n`;\n  \n  if (available.length > 0) {\n    message += `🟢 可用模型（前10个）：\\n`;\n    available.slice(0, 10).forEach(item => {\n      const latency = item.latencyMs ? `${item.latencyMs}ms` : 'N/A';\n      const balance = item.balance ? `$${item.balance}` : '';\n      message += `• ${item.siteName} - ${item.modelName}\\n`;\n      message += `  延迟：${latency}  ${balance}\\n`;\n    });\n    \n    if (available.length > 10) {\n      message += `\\n还有 ${available.length - 10} 个可用模型未显示\\n`;\n    }\n  } else {\n    message += `⚠️ 没有找到可用的模型`;\n  }\n  \n  return { chatId, message, status: 'completed' };\n  \n} else if (data.status === 'running') {\n  return { \n    chatId, \n    message: `🔄 探测范围较大，已在后台执行\\n\\n任务ID：${data.taskId}\\n\\n使用以下命令查询进度：\\n/status ${data.taskId}`,\n    status: 'running',\n    taskId: data.taskId\n  };\n  \n} else {\n  return { \n    chatId, \n    message: `❌ 探测失败：${data.message || '未知错误'}`,\n    status: 'failed'\n  };\n}"
      },
      "id": "format-probe-result",
      "name": "格式化探测结果",
